# Build context: apps/swiftline-next
#
# The app package owns the Next foundation and database pool. This image only
# bundles the worker entry module; it does not start a Next request server.
FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

RUN npm run build:worker

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV SWIFTLINE_WORKER_MODULE=./dist/worker.mjs
ENV WORKER_HEALTH_FILE=/tmp/swiftline-email-worker-health.json

COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
COPY worker-entrypoint.mjs ./worker-entrypoint.mjs

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "worker-entrypoint.mjs", "--healthcheck"]

ENTRYPOINT ["node", "worker-entrypoint.mjs"]
