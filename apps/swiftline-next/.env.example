# Runtime
NODE_ENV=development

# PostgreSQL connection used by the pooled server-side database client.
DATABASE_URL=postgresql://swiftline:local-development-only@localhost:5432/swiftline
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# These defaults match SwiftLine.API's current JWT contract.
JWT_ISSUER=swiftline-api
JWT_AUDIENCE=swiftline-web
JWT_ALGORITHM=HS256
JWT_SECRET=replace-with-a-long-local-development-secret

# Built-in SMTP worker transport. Set SWIFTLINE_EMAIL_MAILER_MODULE only when
# replacing this adapter with a provider-specific idempotent transport.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_EMAIL=noreply@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
# Positive milliseconds. The send timeout covers the complete Nodemailer send.
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SEND_TIMEOUT_MS=60000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_MAX_ATTEMPTS=3
WORKER_HEALTH_FILE=/tmp/swiftline-email-worker-health.json
