{
  "name": "@swiftline/next-service",
  "version": "0.1.0",
  "private": true,
  "description": "SwiftLine's Next.js App Router service foundation",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.mjs --bundle --platform=node --format=esm --packages=external --alias:@=./src --outfile=dist/worker.mjs && esbuild src/worker/smtp-mailer.mjs --bundle --platform=node --format=esm --packages=external --outfile=dist/smtp-mailer.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/auth/auth-session-sql.test.mjs tests/worker/email-worker.test.mjs tests/worker/smtp-mailer.test.mjs tests/worker/sql-contract.test.mjs",
    "test:foundation": "vitest run tests/foundation",
    "test:integration": "node --test tests/integration/postgres.integration.test.mjs",
    "test:watch": "vitest tests"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "next": "16.3.3",
    "nodemailer": "^10.0.3",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
